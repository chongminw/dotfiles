// 快速、克制的动画：移动保持同步，开关窗口略带缓动。
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
    window-open {
        duration-ms 160
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 140
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=850 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=850 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=850 epsilon=0.0001
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=750 epsilon=0.0001
    }
}
